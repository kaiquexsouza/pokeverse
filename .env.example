# Copie este arquivo para .env e preencha.

# Banco local (criado no pgAdmin):
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/pokeverse

# Ou o banco do Render (use a "External Database URL"; o SSL é ativado sozinho):
# DATABASE_URL=postgres://pokeverse:SENHA@dpg-xxxxx-a.oregon-postgres.render.com/pokeverse

# Qualquer texto longo e aleatório (no Render ele é gerado automaticamente)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

PORT=3000
